#!/usr/bin/env bash
set -euo pipefail

# Project-local launcher for the Qwen3 llama.cpp server.
# Override any setting for one invocation, for example: LLAMA_PORT=8082 scripts/llama-server start

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME_DIR="${ROOT_DIR}/.runtime"
PID_FILE="${RUNTIME_DIR}/llama-server.pid"
LOG_FILE="${RUNTIME_DIR}/llama-server.log"

LLAMA_HOST="${LLAMA_HOST:-127.0.0.1}"
LLAMA_PORT="${LLAMA_PORT:-8081}"
LLAMA_CONTEXT_SIZE="${LLAMA_CONTEXT_SIZE:-4096}"
LLAMA_MODEL="${LLAMA_MODEL:-bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF:Q4_K_M}"

usage() {
  cat <<'EOF'
Usage: scripts/llama-server <start|stop|status|logs>

Environment overrides:
  LLAMA_PORT=8082            Bind a different local port.
  LLAMA_CONTEXT_SIZE=8192    Change the context window.
  LLAMA_MODEL=owner/repo:Q4_K_M
EOF
}

process_is_server() {
  local pid="$1"
  local command
  command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ "$command" == *"llama-server"* ]]
}

is_running() {
  [[ -s "$PID_FILE" ]] || return 1
  local pid
  pid="$(<"$PID_FILE")"
  kill -0 "$pid" 2>/dev/null && process_is_server "$pid"
}

port_is_in_use() {
  lsof -nP -iTCP:"$LLAMA_PORT" -sTCP:LISTEN >/dev/null 2>&1
}

start() {
  if ! command -v llama-server >/dev/null 2>&1; then
    echo "llama-server is not installed. Run: brew install llama.cpp" >&2
    exit 1
  fi

  if is_running; then
    echo "llama-server is already running (PID $(<"$PID_FILE")) at http://${LLAMA_HOST}:${LLAMA_PORT}"
    return
  fi

  if [[ -e "$PID_FILE" ]]; then
    rm -f "$PID_FILE"
  fi

  if port_is_in_use; then
    echo "Port ${LLAMA_PORT} is already in use; choose another with LLAMA_PORT=<port>." >&2
    exit 1
  fi

  mkdir -p "$RUNTIME_DIR"
  nohup llama-server \
    --hf-repo "$LLAMA_MODEL" \
    --jinja \
    --host "$LLAMA_HOST" \
    --port "$LLAMA_PORT" \
    --ctx-size "$LLAMA_CONTEXT_SIZE" \
    --n-gpu-layers 99 \
    --no-webui >"$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"

  for _ in {1..60}; do
    if curl --fail --silent --show-error --max-time 1 "http://${LLAMA_HOST}:${LLAMA_PORT}/v1/models" >/dev/null; then
      echo "llama-server is ready at http://${LLAMA_HOST}:${LLAMA_PORT}/v1 (PID ${pid})"
      return
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "llama-server exited during startup. See ${LOG_FILE}" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    sleep 1
  done

  echo "llama-server is still starting. Follow progress with: $0 logs" >&2
}

stop() {
  if ! is_running; then
    [[ -e "$PID_FILE" ]] && rm -f "$PID_FILE"
    echo "llama-server is not running."
    return
  fi

  local pid
  pid="$(<"$PID_FILE")"
  kill "$pid"
  for _ in {1..10}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "llama-server stopped."
      return
    fi
    sleep 1
  done

  echo "llama-server is taking longer than expected to stop (PID ${pid})." >&2
  exit 1
}

status() {
  if is_running; then
    echo "llama-server is running at http://${LLAMA_HOST}:${LLAMA_PORT}/v1 (PID $(<"$PID_FILE"))."
  else
    echo "llama-server is not running."
    return 1
  fi
}

logs() {
  if [[ -f "$LOG_FILE" ]]; then
    tail -n 100 -f "$LOG_FILE"
  else
    echo "No log exists yet. Start the server first." >&2
    exit 1
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  logs) logs ;;
  *) usage; exit 2 ;;
esac
